        </mxCell>

        <!-- Service 1: Accounts -->
        <mxCell id="box_accounts" value="Accounts Service&#xa;[Aarambhika - 20251651001]&#xa;---------------------------------------&#xa;Owns: users, credentials, roles&#xa;Database: nivaaran_accounts&#xa;Port: 8080 (REST / JSON)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontFamily=Helvetica;fontSize=12;fontColor=#000000;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
